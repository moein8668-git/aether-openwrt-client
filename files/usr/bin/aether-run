#!/bin/sh
# Root-only launcher that keeps secrets out of procd/ubus/ps output.

UCI=/sbin/uci

# Core v2's embedded Tor/Arti creates persistent state beneath --tor-dir.
# Inherit a private umask so every parent directory passes Arti's security check.
umask 077

team="$($UCI -q get aether.main.team 2>/dev/null)"
if [ -n "$team" ]; then
	access_id="$($UCI -q get aether.main.access_id 2>/dev/null)"
	access_secret="$($UCI -q get aether.main.access_secret 2>/dev/null)"
	access_token="$($UCI -q get aether.main.access_token 2>/dev/null)"
	gateway="$($UCI -q get aether.main.gateway 2>/dev/null)"

	export AETHER_TEAM="$team"
	export AETHER_ACCESS_CLIENT_ID="$access_id"
	export AETHER_ACCESS_CLIENT_SECRET="$access_secret"
	export AETHER_ACCESS_TOKEN="$access_token"
	[ "$gateway" = "1" ] && export AETHER_GATEWAY=1
fi

# Core v2.4 pins the MASQUE gateway certificate by default with --team. The
# only way to turn that off is this environment variable (there is no flag),
# so tls_verify=0 is applied here. It is not a secret.
tls_verify="$($UCI -q get aether.main.tls_verify 2>/dev/null)"
[ "$tls_verify" = "0" ] && export AETHER_TLS_VERIFY=0

exec /usr/bin/aether "$@"
